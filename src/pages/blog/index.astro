---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="intro">
        <h1>Field Journal — <em>Place</em></h1>
        <p>An investigation into sense of place across the Pacific Northwest. Landscapes, streets, coastlines, and the people within them.</p>
      </section>
      <section class="posts">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="post-card">
            <div class="post-meta">
              <span class="post-type">{post.data.type}</span>
              <span class="post-city">{post.data.city}</span>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="post-lens">{post.data.lens}</span>
          </a>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
