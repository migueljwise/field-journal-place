---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import img1 from '../assets/home-01.jpg';
import img2 from '../assets/home-02.jpg';
import img3 from '../assets/home-03.jpg';
import img4 from '../assets/home-04.jpg';
import img5 from '../assets/home-05.jpg';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="intro">
        <h1>Miguel Wise</h1>
        <p>I like places & landscapes, books & stories</p>
      </section>

      <div class="image-grid">
        <div class="cell cell-1">
          <Image src={img1} alt="" />
        </div>
        <div class="cell cell-2">
          <Image src={img2} alt="" />
        </div>
        <div class="cell cell-3">
          <Image src={img3} alt="" />
        </div>
        <div class="cell cell-4">
          <Image src={img4} alt="" />
        </div>
        <div class="cell cell-5">
          <Image src={img5} alt="" />
        </div>
      </div>

      <section class="projects">
        <a href="/peoplespacespnw/" class="project-card">
          <h2>People Spaces of the PNW</h2>
          <p>Field notes on public spaces in the Pacific Northwest.</p>
        </a>
        <a href="/writing/" class="project-card">
          <h2>Writing</h2>
          <p>Articles and essays.</p>
        </a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .intro {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid #e0e0e0;
    padding-bottom: 2rem;
  }
  .intro h1 {
    font-size: 2.5rem;
    font-weight: 300;
    margin-bottom: 1rem;
  }
  .intro p {
    font-size: 1.1rem;
    color: #555;
    line-height: 1.7;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 220px 220px 220px;
    gap: 3px;
    margin-left: -1.5rem;
    margin-right: -1.5rem;
    margin-bottom: 3rem;
  }

  .cell-1 { grid-column: 1 / 3; grid-row: 1; }
  .cell-2 { grid-column: 3;     grid-row: 1; }
  .cell-3 { grid-column: 1;     grid-row: 2; }
  .cell-4 { grid-column: 2 / 4; grid-row: 2; }
  .cell-5 { grid-column: 1 / 4; grid-row: 3; }

  .cell {
    overflow: hidden;
  }
  .cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 600px) {
    .image-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 160px 160px 160px;
      margin-left: -1rem;
      margin-right: -1rem;
    }
    .cell-1,
    .cell-2,
    .cell-3,
    .cell-4,
    .cell-5 {
      grid-column: auto;
      grid-row: auto;
    }
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .project-card {
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid #e0e0e0;
    padding-bottom: 2rem;
  }
  .project-card:hover h2 {
    color: #c0392b;
  }
  .project-card h2 {
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
    transition: color 0.15s;
  }
  .project-card p {
    font-size: 0.95rem;
    color: #555;
    line-height: 1.6;
  }
</style>