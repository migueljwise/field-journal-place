---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="About" description="About Field Journal — Place" />
  </head>
  <body>
    <Header />
    <main>
      <h1>About</h1>
      <div class="content">
<p>I am working to understand places:</p>
<ul>
  <li>What are they made of?</li>
  <li>How are they made?</li>
  <li>What do we do with them?</li>
  <li>How do they change?</li>
  <li>How do they affect us?</li>
</ul>
<p><a href="mailto:agoodlife.zine@gmail.com?subject=A%20place%20I%20know">Write to me!</a></p>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  h1 {
    font-size: 2rem;
    font-weight: 300;
    margin-bottom: 2rem;
    border-bottom: 0.5px solid #e0e0e0;
    padding-bottom: 1rem;
  }
  .content p {
    font-size: 1rem;
    line-height: 1.8;
    color: #333;
    margin-bottom: 1rem;
    font-weight: 300;
  }
</style>
